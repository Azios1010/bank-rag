# PostgreSQL / pgvector
POSTGRES_DB=digital_expert_agents
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<local-postgres-password>
DATABASE_URL=postgresql+psycopg2://postgres:<local-postgres-password>@localhost:5432/digital_expert_agents

# Supabase canonical Corpus V2 (backend-only trusted settings; never NEXT_PUBLIC)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<project-key>
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<backend-only-key>
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_STORAGE_POLICY_BUCKET=policy-sources
SUPABASE_STORAGE_CASE_BUCKET=case-documents
SUPABASE_STORAGE_ARTIFACT_BUCKET=corpus-artifacts

# Canonical V2 query adapter endpoint (llama.cpp OpenAI-compatible embeddings API)
LLAMA_EMBEDDING_BASE_URL=http://127.0.0.1:8081
# Canonical V2 dedicated reranker endpoint (backend-only llama.cpp service)
LLAMA_RERANKER_BASE_URL=http://127.0.0.1:8082

# MinIO object storage
MINIO_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<local-minio-password>
MINIO_CASE_BUCKET=case-documents
MINIO_POLICY_BUCKET=bank-policies
MINIO_SECURE=false
MAX_UPLOAD_BYTES=20971520

# Embedding Configuration (OpenAI-compatible)
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_BASE=https://mkp-api.fptcloud.com
EMBEDDING_API_KEY=<embedding-api-key>
EMBEDDING_MODEL=Vietnamese_Embedding
EMBEDDING_DIMENSION=1024

# Generation Configuration (OpenAI-compatible)
LLM_PROVIDER=openai_compatible
LLM_API_BASE=https://mkp-api.fptcloud.com
LLM_API_KEY=<llm-api-key>
LLM_MODEL=GLM-5.2
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
AGENT_DOCUMENT_CONTEXT_CHARS=60000

# Workflow and demo bootstrap
MAX_DEBATE_ROUNDS=3
SEED_DEMO_POLICIES=false
SEED_DEMO_CASE=true
SEED_HHB_POLICY=true
HHB_POLICY_PATH=backend/resources/policies/QD-HHB-2026-01.txt
DEMO_OFFICER_ID=demo-officer
DEMO_CASE_DOCUMENT_PATH=backend/resources/demo/minh-an-credit-dossier.txt
POLICY_ADMIN_OFFICER_IDS=demo-officer

# Application URLs
APP_DEBUG=false
AUTH_MODE=demo
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
POLICY_ADMIN_ROLES=policy_admin
CASE_ADMIN_ROLES=case_admin
ENABLE_MOCK_APIS=true
BACKEND_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_OFFICER_ID=demo-officer
