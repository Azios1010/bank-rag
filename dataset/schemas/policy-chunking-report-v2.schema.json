{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "chunker_version", "total_input_provisions", "total_emitted_chunks",
    "total_anomalies", "anomalies_by_type", "context_mode", "hard_limit", "max_emitted_characters"
  ],
  "properties": {
    "chunker_version": { "type": "string" },
    "total_input_provisions": { "type": "integer" },
    "total_emitted_chunks": { "type": "integer" },
    "total_anomalies": { "type": "integer" },
    "anomalies_by_type": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "context_mode": { "const": "metadata_only" },
    "hard_limit": { "const": 4800 },
    "max_emitted_characters": { "type": "integer", "maximum": 4800 }
  },
  "additionalProperties": false
}
