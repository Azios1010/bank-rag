{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank-rag.local/schema/retrieval-evaluation-v2.json",
  "title": "Bank RAG Corpus V2 retrieval gold record",
  "description": "Evidence-first retrieval evaluation records. DRAFT records are review inputs; only REVIEWED records may be exported as frozen gold.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "query", "query_type", "specialist_scope", "assessment_date", "filters", "expected_canonical_chunk_ids", "gold_evidence", "forbidden_version_ids", "expected_coverage", "tags", "document", "visibility", "is_synthetic", "corpus_identity", "embedding_identity", "status", "creation_provenance", "review"],
  "properties": {
    "schema_version": {"const": "retrieval-gold-v2.0.0"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1},
    "query_type": {"enum": ["POLICY_LOOKUP", "ELIGIBILITY_SUPPORT", "CALCULATION_GUIDANCE", "MULTI_SOURCE"]},
    "specialist_scope": {"enum": ["customer_relationship", "credit", "risk_management", "legal_compliance", "collateral_appraisal"]},
    "assessment_date": {"type": "string", "format": "date"},
    "filters": {"type": "object"},
    "expected_canonical_chunk_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "gold_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "forbidden_version_ids": {"type": "array", "items": {"type": "string"}},
    "expected_coverage": {"enum": ["SUFFICIENT", "INSUFFICIENT"]},
    "tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "document": {"$ref": "#/$defs/document"},
    "visibility": {"enum": ["SHARED", "SCOPED"]},
    "is_synthetic": {"type": "boolean"},
    "corpus_identity": {"$ref": "#/$defs/corpus_identity"},
    "embedding_identity": {"$ref": "#/$defs/embedding_identity"},
    "status": {"enum": ["DRAFT", "REVIEWED", "REJECTED"]},
    "creation_provenance": {"$ref": "#/$defs/creation_provenance"},
    "review": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/review"}]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "DRAFT"}}}, "then": {"properties": {"review": {"type": "null"}}}},
    {"if": {"properties": {"status": {"enum": ["REVIEWED", "REJECTED"]}}}, "then": {"properties": {"review": {"$ref": "#/$defs/review"}}}}
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_chunk_id", "source_id", "version_id", "document_title", "heading_path", "locator", "excerpt", "rationale", "visibility", "is_synthetic", "namespace"],
      "properties": {
        "canonical_chunk_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_id": {"type": "string", "minLength": 1},
        "version_id": {"type": "string", "minLength": 1},
        "document_title": {"type": "string", "minLength": 1},
        "heading_path": {"type": "array", "items": {"type": "string"}},
        "locator": {"$ref": "#/$defs/locator"},
        "excerpt": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["SHARED", "SCOPED"]},
        "is_synthetic": {"type": "boolean"},
        "namespace": {"enum": ["REGULATION", "BANK_PRODUCT", "UNDERWRITING_POLICY"]}
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["article", "clause", "point", "page_start", "page_end", "jsonl_line"],
      "properties": {
        "article": {"type": ["string", "null"]},
        "clause": {"type": ["string", "null"]},
        "point": {"type": ["string", "null"]},
        "page_start": {"type": ["integer", "null"]},
        "page_end": {"type": ["integer", "null"]},
        "jsonl_line": {"type": "integer", "minimum": 1}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "version_id", "title", "issuer", "document_number", "issue_date", "effective_date", "source_artifact_path", "source_artifact_sha256", "provenance", "synthetic", "namespace"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "version_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "issuer": {"type": ["string", "null"]},
        "document_number": {"type": ["string", "null"]},
        "issue_date": {"type": ["string", "null"]},
        "effective_date": {"type": ["string", "null"]},
        "source_artifact_path": {"type": "string", "minLength": 1},
        "source_artifact_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "provenance": {"enum": ["real_authoritative", "synthetic"]},
        "synthetic": {"type": "boolean"},
        "namespace": {"enum": ["REGULATION", "BANK_PRODUCT", "UNDERWRITING_POLICY"]}
      }
    },
    "corpus_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "corpus_name", "chunk_count", "corpus_jsonl_sha256", "corpus_manifest_sha256", "corpus_v2_hash", "manifest_hash"],
      "properties": {
        "version": {"const": "V2"},
        "corpus_name": {"const": "policy-corpus-v2"},
        "chunk_count": {"const": 1610},
        "corpus_jsonl_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "corpus_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "corpus_v2_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "embedding_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "format", "dimension", "dtype", "normalization", "pooling", "runtime", "backend", "embedding_artifact_sha256", "embedding_manifest_sha256", "query_instruction", "document_template"],
      "properties": {
        "model": {"const": "Qwen3-Embedding-0.6B"},
        "format": {"const": "GGUF F16"},
        "dimension": {"const": 1024},
        "dtype": {"const": "float32"},
        "normalization": {"const": "L2 unit"},
        "pooling": {"const": "last"},
        "runtime": {"const": "llama.cpp"},
        "backend": {"const": "Vulkan"},
        "embedding_artifact_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "embedding_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "query_instruction": {"type": "string", "minLength": 1},
        "document_template": {"type": "string", "minLength": 1}
      }
    },
    "creation_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "evidence_source", "retrieval_used", "generated_by", "created_at"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "evidence_source": {"type": "string", "minLength": 1},
        "retrieval_used": {"const": false},
        "generated_by": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "reviewed_at", "decision"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "decision": {"enum": ["REVIEWED", "REJECTED"]},
        "notes": {"type": "string"}
      }
    }
  }
}
